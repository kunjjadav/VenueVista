# VenueVista environment config — copy to .env and fill in values

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---- PostgreSQL + PostGIS ----
POSTGRES_DB=venuevista
POSTGRES_USER=venuevista
POSTGRES_PASSWORD=venuevista_secure_pwd_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis (Celery Broker) ----
REDIS_PASSWORD=venuevista_redis_pwd_2026
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---- Google Cloud APIs ----
# Required: Maps JavaScript API, Places API (New), Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_MAP_ID=your-google-maps-map-id-here

# Cache TTL
SEARCH_CACHE_TTL_DAYS=30

# ---- Frontend ----
# For Docker: use http://backend:8000/api (Docker service name)
# For local dev (no Docker): use http://localhost:8000/api
VITE_API_BASE_URL=http://backend:8000/api
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id-here
